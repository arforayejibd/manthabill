<%- include('../partials/guest_header') %>

<div class="login-box">
    <div class="login-logo">
        <a href="#" class="text-white"><b><%= setting.nama_hosting || 'One HostBilling' %></b> Register</a>
    </div>
    <div class="card">
        <div class="card-body register-card-body">
            <% if (pesan) { %>
                <div class="alert alert-danger"><%= pesan %></div>
            <% } %>
            <% if (pesan2) { %>
                <%- pesan2 %>
            <% } %>
            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        <% errors.forEach(function(error) { %>
                            <li><%= error %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <form action="/register" method="POST">
                <input type="hidden" name="_token" id="csrftoken" class="token_csrf" value="">

                <div class="input-group mb-3">
                    <input type="email" name="email" id="email" class="form-control" placeholder="Email"
                           value="<%= typeof oldEmail !== 'undefined' ? oldEmail : '' %>" required>
                    <div class="input-group-append">
                        <div class="input-group-text"><span class="fas fa-envelope"></span></div>
                    </div>
                    <span id="username_result2" class="w-100"></span>
                </div>

                <div class="input-group mb-3">
                    <input type="password" name="password" class="form-control" placeholder="Password" maxlength="50" required>
                    <div class="input-group-append">
                        <div class="input-group-text"><span class="fas fa-lock"></span></div>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <input type="password" name="password2" class="form-control" placeholder="Repeat Password" maxlength="50" required>
                    <div class="input-group-append">
                        <div class="input-group-text"><span class="fas fa-lock"></span></div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-8">
                        <div class="icheck-primary">
                            <input type="checkbox" name="tos" id="agreeTerms" value="1">
                            <label for="agreeTerms">
                                Agree to <a href="<%= setting.tos || '#' %>" target="_blank">T.O.S</a>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="card bg-light p-2 text-center">
                            <strong style="font-size:1.4rem; letter-spacing:4px;"><%= captchaWord %></strong>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <input type="text" name="captcha" class="form-control" placeholder="captcha" required>
                    </div>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-danger btn-block">Register Account</button>
                </div>
            </form>

            <div class="col-md-12 mt-3">Already Have An Account?</div>
            <a href="/login">
                <button type="button" class="btn btn-primary btn-block btn-flat">Login</button>
            </a>
        </div>
    </div>
</div>

<%- include('../partials/guest_footer') %>

<script>
    $(document).ready(function () {
        function generateCsrf() {
            $.ajax({
                type: 'GET',
                dataType: 'json',
                url: '/register/get-csrf',
                success: function (data) {
                    $('#csrftoken').attr('name', data.csrf_name).val(data.csrf_token);
                }
            });
        }
        generateCsrf();

        $('#email').blur(function () {
            var csrfName = $('.token_csrf').attr('name') || '_token';
            var csrfHash = $('.token_csrf').val();
            var email = $(this).val();
            if (email.length === 0) {
                $('#username_result2').html('');
                $('#email').removeClass('is-invalid is-valid');
                return;
            }
            $.ajax({
                type: 'POST',
                url: '/register/check-email',
                data: { [csrfName]: csrfHash, email: email },
                success: function (data) {
                    if (data === 'ok') {
                        $('#username_result2').html('<font color="red"><i class="fas fa-times-circle"></i> is already registered</font>');
                        $('#email').removeClass('is-valid').addClass('is-invalid');
                        generateCsrf();
                    } else {
                        $('#username_result2').html('');
                        $('#email').removeClass('is-invalid').addClass('is-valid');
                        generateCsrf();
                    }
                }
            });
        });
    });
</script>
