<%- include('../partials/admin_header') %>

<%- include('../partials/admin_navbar') %>
<%- include('../partials/admin_sidebar') %>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6"><h1>Invoices</h1></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/staff/Admin">Home</a></li>
                        <li class="breadcrumb-item active">Invoices</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">System Invoices Registry</h3>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Invoice No</th>
                                <th>Client ID</th>
                                <th>Created Date</th>
                                <th>Due Date</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (invoices && invoices.length > 0) { %>
                                <% invoices.forEach(function(invoice) { %>
                                    <% 
                                      const createD = new Date(invoice.created_at);
                                      const cd = String(createD.getDate()).padStart(2, '0');
                                      const cm = String(createD.getMonth() + 1).padStart(2, '0');
                                      const cy = createD.getFullYear();
                                      
                                      const dueD = new Date(invoice.due_date);
                                      const dd = String(dueD.getDate()).padStart(2, '0');
                                      const dm = String(dueD.getMonth() + 1).padStart(2, '0');
                                      const dy = dueD.getFullYear();
                                    %>
                                    <tr>
                                        <td>#INV-<%= invoice.id %></td>
                                        <td>#<%= invoice.tbuser ? invoice.tbuser.client : '—' %></td>
                                        <td><%= `${cd}-${cm}-${cy}` %></td>
                                        <td><%= `${dd}-${dm}-${dy}` %></td>
                                        <td>$<%= parseFloat(invoice.total).toFixed(2) %></td>
                                        <td>
                                            <% if (invoice.status_pembayaran === 1) { %>
                                                <span class="badge badge-success">Paid</span>
                                            <% } else if (invoice.status_pembayaran === 2) { %>
                                                <span class="badge badge-warning">Unpaid</span>
                                            <% } else { %>
                                                <span class="badge badge-danger">Cancelled</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="6" class="text-center py-4 text-muted">No invoice records found.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/admin_footer') %>
