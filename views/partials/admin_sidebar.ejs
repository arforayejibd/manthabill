<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a href="/staff/Admin" class="brand-link">
        <img src="/assets/AdminLTE3/dist/img/AdminLTELogo.png" alt="Logo"
             class="brand-image img-circle elevation-3" style="opacity: .8">
        <span class="brand-text font-weight-light"><%= setting.nama_hosting || 'One HostBilling' %></span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Sidebar user panel -->
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                <img src="/assets/AdminLTE3/dist/img/avatar.png" class="img-circle elevation-2" alt="Admin">
            </div>
            <div class="info ml-3">
                <a href="/staff/Admin" class="d-block">Administrator</a>
            </div>
        </div>

        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                
                <!-- Dashboard -->
                <li class="nav-item">
                    <a href="/staff/Admin" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">
                        <i class="nav-icon fas fa-tachometer-alt"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <!-- Clients -->
                <li class="nav-item">
                    <a href="/staff/Admin/user" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'clients' ? 'active' : '' %>">
                        <i class="nav-icon fas fa-users"></i>
                        <p>Clients</p>
                    </a>
                </li>

                <!-- Domain (treeview) -->
                <% 
                  const isDomainOpen = typeof activeMenu !== 'undefined' && (activeMenu === 'domains' || activeMenu === 'tlds');
                %>
                <li class="nav-item has-treeview <%= isDomainOpen ? 'menu-open' : '' %>">
                    <a href="#" class="nav-link <%= isDomainOpen ? 'active' : '' %>">
                        <i class="nav-icon fas fa-globe"></i>
                        <p>Domain <i class="fas fa-angle-left right"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="/staff/Admin/domain" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'domains' ? 'active' : '' %>">
                                <i class="nav-icon far fa-circle"></i>
                                <p>Domain Accounts</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/staff/Admin/service_domain" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'tlds' ? 'active' : '' %>">
                                <i class="nav-icon far fa-circle"></i>
                                <p>TLD Pricing</p>
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Service (treeview) -->
                <% 
                  const isServiceOpen = typeof activeMenu !== 'undefined' && activeMenu === 'shared_hostings';
                %>
                <li class="nav-item has-treeview <%= isServiceOpen ? 'menu-open' : '' %>">
                    <a href="#" class="nav-link <%= isServiceOpen ? 'active' : '' %>">
                        <i class="nav-icon fas fa-box"></i>
                        <p>Service <i class="fas fa-angle-left right"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="/staff/Admin/shared_hosting" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'shared_hostings' ? 'active' : '' %>">
                                <i class="nav-icon far fa-circle"></i>
                                <p>Shared Hosting</p>
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Invoice -->
                <li class="nav-item">
                    <a href="/staff/Admin/invoice" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'invoices' ? 'active' : '' %>">
                        <i class="nav-icon fas fa-credit-card"></i>
                        <p>Invoice</p>
                    </a>
                </li>

                <!-- Inbox -->
                <li class="nav-item">
                    <a href="/staff/Admin/inbox" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'tickets' ? 'active' : '' %>">
                        <i class="nav-icon fas fa-comments"></i>
                        <p>Inbox</p>
                    </a>
                </li>

                <!-- Packages (treeview) -->
                <% 
                  const isPackagesOpen = typeof activeMenu !== 'undefined' && activeMenu === 'packages';
                %>
                <li class="nav-item has-treeview <%= isPackagesOpen ? 'menu-open' : '' %>">
                    <a href="#" class="nav-link <%= isPackagesOpen ? 'active' : '' %>">
                        <i class="nav-icon fas fa-box-open"></i>
                        <p>Hosting Packages <i class="fas fa-angle-left right"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="/staff/Admin/paket" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'packages' ? 'active' : '' %>">
                                <i class="nav-icon far fa-circle"></i>
                                <p>Shared Hosting</p>
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Setting (treeview) -->
                <% 
                  const isSettingOpen = typeof activeMenu !== 'undefined' && (activeMenu === 'settings_general' || activeMenu === 'settings_api' || activeMenu === 'help');
                %>
                <li class="nav-item has-treeview <%= isSettingOpen ? 'menu-open' : '' %>">
                    <a href="#" class="nav-link <%= isSettingOpen ? 'active' : '' %>">
                        <i class="nav-icon fas fa-cog"></i>
                        <p>Setting <i class="fas fa-angle-left right"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="/staff/Admin/setting_umum" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'settings_general' ? 'active' : '' %>">
                                <i class="nav-icon far fa-circle"></i>
                                <p>General</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/staff/Admin/setting_api" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'settings_api' ? 'active' : '' %>">
                                <i class="nav-icon far fa-circle"></i>
                                <p>Setting API</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/staff/Admin/help" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'help' ? 'active' : '' %>">
                                <i class="nav-icon far fa-circle"></i>
                                <p>Help</p>
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
        <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
</aside>
