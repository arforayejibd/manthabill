<%- include('../partials/user_header') %>

<%- include('../partials/user_navbar') %>
<%- include('../partials/user_sidebar') %>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Support Tickets</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Member">Home</a></li>
                        <li class="breadcrumb-item active">Tickets</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <% if (pesan) { %>
                        <%- pesan %>
                    <% } %>
                    <% if (pesan2) { %>
                        <%- pesan2 %>
                    <% } %>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-dark">
                        <div class="card-header">
                            <h3 class="card-title">Your Support Tickets</h3>
                            <a href="/Ticket/buat" class="btn btn-success float-right">
                                <i class="fas fa-plus-square mr-1"></i> Create Ticket
                            </a>
                        </div>
                        <div class="card-body">
                            <table id="tabelku" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th class="text-center">No</th>
                                        <th class="text-center">Date</th>
                                        <th class="text-center">Subject</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (tickets && tickets.length > 0) { %>
                                        <% tickets.forEach(function(ticket, i) { %>
                                            <tr>
                                                <td class="text-center"><%= i + 1 %></td>
                                                <td class="text-center">
                                                    <% 
                                                      const tDate = new Date(ticket.time * 1000);
                                                      const td = String(tDate.getDate()).padStart(2, '0');
                                                      const tm = String(tDate.getMonth() + 1).padStart(2, '0');
                                                      const ty = tDate.getFullYear();
                                                    %>
                                                    <%= `${td}-${tm}-${ty}` %>
                                                </td>
                                                <td class="text-left"><%= ticket.judul %></td>
                                                <td class="text-center">
                                                    <% if (ticket.status_inbox === 1) { %>
                                                        <small class="badge badge-success">OPEN</small>
                                                    <% } else if (ticket.status_inbox === 2) { %>
                                                        <small class="badge badge-warning">ANSWERED</small>
                                                    <% } else { %>
                                                        <small class="badge badge-danger">CLOSED</small>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <a href="/Ticket/lihat_ticket/<%= ticket.key_token %>" class="btn btn-primary btn-sm" title="View Message">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <% if (ticket.status_inbox < 3) { %>
                                                        <button class="btn btn-danger btn-sm close-ticket-btn" 
                                                                data-toggle="modal"
                                                                data-target="#modalKunci"
                                                                data-id="<%= ticket.key_token %>"
                                                                title="Close Ticket">
                                                            <i class="fas fa-lock"></i>
                                                        </button>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-3">
                                                No support tickets found.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal Kunci Pesan -->
<div class="modal fade" id="modalKunci" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Close Ticket</h5>
            </div>
            <div class="modal-body">
                Are you sure you want to close and lock this support ticket?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <a href="" id="urlKunci">
                    <button type="button" class="btn btn-danger">Close Ticket</button>
                </a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/user_footer') %>
