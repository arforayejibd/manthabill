<%- include('../partials/admin_header') %>

<%- include('../partials/admin_navbar') %>
<%- include('../partials/admin_sidebar') %>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6"><h1>TLD Pricing</h1></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/staff/Admin">Home</a></li>
                        <li class="breadcrumb-item active">TLDs</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Supported Domain Extensions</h3>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th>TLD</th>
                                <th>Registration Price (Yearly)</th>
                                <th>Default TLD</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (tlds && tlds.length > 0) { %>
                                <% tlds.forEach(function(tld) { %>
                                    <tr>
                                        <td><strong>.<%= tld.tld %></strong></td>
                                        <td>$<%= parseFloat(tld.harga_tld).toFixed(2) %></td>
                                        <td>
                                            <% if (tld.default === 1) { %>
                                                <span class="badge badge-info">Yes</span>
                                            <% } else { %>
                                                <span class="badge badge-secondary">No</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (tld.status_tld === 1) { %>
                                                <span class="badge badge-success">Active</span>
                                            <% } else { %>
                                                <span class="badge badge-danger">Disabled</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="4" class="text-center py-4 text-muted">No TLD pricing records found.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/admin_footer') %>
