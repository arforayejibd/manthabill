<%- include('../partials/user_header') %>

<%- include('../partials/user_navbar') %>
<%- include('../partials/user_sidebar') %>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Create Support Ticket</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Member">Home</a></li>
                        <li class="breadcrumb-item"><a href="/Ticket">Ticket</a></li>
                        <li class="breadcrumb-item active">Create</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">

                            <% if (pesan) { %>
                                <%- pesan %>
                            <% } %>

                            <% if (errors && errors.length > 0) { %>
                                <% errors.forEach(function(error) { %>
                                    <div class="alert alert-danger" role="alert"><%= error %></div>
                                <% }); %>
                            <% } %>

                            <form action="/Ticket/buat" method="POST">
                                <div class="form-group">
                                    <label for="judulPesan">
                                        Subject / Message Title <span class="text-danger">*</span>
                                    </label>
                                    <input type="text"
                                           name="judulPesan"
                                           id="judulPesan"
                                           class="form-control"
                                           placeholder="e.g. Hosting Problem"
                                           maxlength="80"
                                           value="<%= typeof oldJudulPesan !== 'undefined' ? oldJudulPesan : '' %>"
                                           required>
                                </div>

                                <div class="form-group">
                                    <label for="isiPesan">
                                        Message Content <span class="text-danger">*</span>
                                    </label>
                                    <textarea name="isiPesan"
                                              id="isiPesan"
                                              class="form-control"
                                              rows="5"
                                              placeholder="Write your issue details here..."
                                              maxlength="400"
                                              required><%= typeof oldIsiPesan !== 'undefined' ? oldIsiPesan : '' %></textarea>
                                </div>

                                <div class="row form-group">
                                    <div class="col-md-8">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="card bg-light p-2 text-center mb-0">
                                                    <strong style="font-size:1.4rem; letter-spacing:4px;">
                                                        <%= captchaWord %>
                                                    </strong>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <input type="text"
                                                       name="captcha"
                                                       class="form-control"
                                                       placeholder="Enter captcha"
                                                       required>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                    <a href="/Ticket" class="btn btn-danger">Cancel</a>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/user_footer') %>
