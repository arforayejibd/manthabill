<%- include('../partials/user_header') %>

<%- include('../partials/user_navbar') %>
<%- include('../partials/user_sidebar') %>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Ticket Details</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Member">Home</a></li>
                        <li class="breadcrumb-item"><a href="/Ticket">Ticket</a></li>
                        <li class="breadcrumb-item active">Detail</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">

            <% if (pesan) { %>
                <%- pesan %>
            <% } %>
            <% if (pesan2) { %>
                <%- pesan2 %>
            <% } %>

            <% if (errors && errors.length > 0) { %>
                <% errors.forEach(function(error) { %>
                    <div class="alert alert-danger" role="alert"><%= error %></div>
                <% }); %>
            <% } %>

            <div class="row">
                <div class="col-md-12">
                    <div class="timeline">

                        <% 
                          const ticketDate = new Date(ticket.time * 1000);
                          const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                          const formattedLabel = `${ticketDate.getDate()}-${months[ticketDate.getMonth()]}-${ticketDate.getFullYear()}`;
                        %>
                        <div class="time-label">
                            <span class="bg-red"><%= formattedLabel %></span>
                        </div>

                        <!-- Opening ticket message -->
                        <div>
                            <i class="fas fa-envelope bg-blue"></i>
                            <div class="timeline-item">
                                <span class="time">
                                    <i class="fas fa-clock"></i>
                                    <%= String(ticketDate.getHours()).padStart(2, '0') %>:<%= String(ticketDate.getMinutes()).padStart(2, '0') %>
                                </span>
                                <h3 class="timeline-header">
                                    <span class="text-primary font-weight-bold">
                                        <%= (userDetail && userDetail.nama_depan) ? userDetail.nama_depan : 'Member' %>
                                    </span>
                                    &mdash;
                                    <span class="font-weight-bold"><%= ticket.judul.toUpperCase() %></span>
                                </h3>
                                <div class="timeline-body">
                                    <%- ticket.pesan.replace(/\n/g, '<br>') %>
                                </div>
                            </div>
                        </div>

                        <!-- Reply messages -->
                        <% if (replies && replies.length > 0) { %>
                            <% replies.forEach(function(reply) { %>
                                <% const rDate = new Date(reply.time * 1000); %>
                                <div>
                                    <% if (reply.is_admin === 1) { %>
                                        <i class="fas fa-comments bg-yellow"></i>
                                    <% } else { %>
                                        <i class="fas fa-envelope bg-blue"></i>
                                    <% } %>
                                    <div class="timeline-item">
                                        <span class="time">
                                            <i class="fas fa-clock"></i>
                                            <%= String(rDate.getHours()).padStart(2, '0') %>:<%= String(rDate.getMinutes()).padStart(2, '0') %>
                                        </span>
                                        <% if (reply.is_admin !== 1) { %>
                                            <h3 class="timeline-header">
                                                <span class="text-danger font-weight-bold">You</span>
                                            </h3>
                                        <% } else { %>
                                            <h3 class="timeline-header">
                                                <span class="text-blue font-weight-bold">Admin</span>
                                                &mdash;
                                                <span class="font-weight-bold">Staff Reply</span>
                                            </h3>
                                        <% } %>
                                        <div class="timeline-body">
                                            <%- reply.pesan.replace(/\n/g, '<br>') %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>

                        <div>
                            <i class="fas fa-clock bg-gray"></i>
                        </div>

                    </div>
                </div>
            </div>

            <% if (ticket.status_inbox !== 3) { %>
                <div class="row mt-3">
                    <div class="col-md-12">
                        <form action="/Ticket/balas/<%= ticket.key_token %>" method="POST">
                            <div class="form-floating">
                                <textarea name="isiPesan"
                                          id="isiPesan"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Write your reply message here..."
                                          maxlength="400"
                                          required></textarea>
                            </div>
                            <div class="form-group clearfix mt-3">
                                <a href="/Ticket" class="btn btn-danger">Back</a>
                                <button type="submit" class="btn btn-primary">Send Reply</button>
                            </div>
                        </form>
                    </div>
                </div>
            <% } else { %>
                <div class="mt-3">
                    <a href="/Ticket" class="btn btn-danger">
                        <i class="fas fa-chevron-circle-left"></i> Back
                    </a>
                </div>
            <% } %>

        </div>
    </section>
</div>

<%- include('../partials/user_footer') %>
