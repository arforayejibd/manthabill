<%- include('../partials/user_header') %>

<%- include('../partials/user_navbar') %>
<%- include('../partials/user_sidebar') %>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Invoices</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Member">Home</a></li>
                        <li class="breadcrumb-item active">Invoices</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-dark">
                        <div class="card-header">
                            <h3 class="card-title">Your Invoice List</h3>
                        </div>
                        <div class="card-body">
                            <% if (pesan) { %>
                                <%- pesan %>
                            <% } %>
                            <table id="tabelku" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th class="text-center">No</th>
                                        <th class="text-center">INVOICE</th>
                                        <th class="text-center">DATE</th>
                                        <th class="text-center">DUE DATE</th>
                                        <th class="text-center">TOTAL</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (invoices && invoices.length > 0) { %>
                                        <% invoices.forEach(function(invoice, i) { %>
                                            <tr>
                                                <td class="text-center"><%= i + 1 %></td>
                                                <td class="text-center"><%= invoice.no_invoice.toUpperCase() %></td>
                                                <td class="text-center">
                                                    <% 
                                                      const dDate = new Date(invoice.inv_date);
                                                      const dd = String(dDate.getDate()).padStart(2, '0');
                                                      const dm = String(dDate.getMonth() + 1).padStart(2, '0');
                                                      const dy = dDate.getFullYear();
                                                    %>
                                                    <%= `${dd}-${dm}-${dy}` %>
                                                </td>
                                                <td class="text-center">
                                                    <% 
                                                      const eDate = new Date(invoice.due);
                                                      const edd = String(eDate.getDate()).padStart(2, '0');
                                                      const emm = String(eDate.getMonth() + 1).padStart(2, '0');
                                                      const eyy = eDate.getFullYear();
                                                    %>
                                                    <%= `${edd}-${emm}-${eyy}` %>
                                                </td>
                                                <td class="text-center">Rp <%= Number(invoice.total_jumlah).toLocaleString('id-ID') %>,-</td>
                                                <td class="text-center">
                                                    <% if (invoice.status_inv === 1) { %>
                                                        <small class="badge badge-primary">PAID</small>
                                                    <% } else if (invoice.status_inv === 2) { %>
                                                        <small class="badge badge-warning">UNPAID / PENDING</small>
                                                    <% } else if (invoice.status_inv === 3) { %>
                                                        <small class="badge badge-info">UNDER REVIEW</small>
                                                    <% } else { %>
                                                        <small class="badge badge-danger">VOID</small>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <a href="/Invoice/detail/<%= encrypt(invoice.id) %>" class="btn bg-olive margin btn-sm">
                                                        VIEW
                                                    </a>
                                                    <% if (invoice.status_inv === 2) { %>
                                                        <a href="/Invoice/bayar/<%= encrypt(invoice.id) %>" class="btn btn-danger btn-sm">
                                                            PAY
                                                        </a>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-3">No invoices found</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/user_footer') %>
