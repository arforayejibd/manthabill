<%- include('../partials/user_header') %>

<%- include('../partials/user_navbar') %>
<%- include('../partials/user_sidebar') %>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Services</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Member">Home</a></li>
                        <li class="breadcrumb-item active">Services</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">

            <% if (pesan) { %>
                <%- pesan %>
            <% } %>

            <div class="row">
                <div class="col-md-12">
                    <div class="card card-info">
                        <div class="card-header">
                            <h3 class="card-title">Your Hosting Services</h3>
                        </div>
                        <div class="card-body">
                            <table id="tabelService" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th class="text-center">No</th>
                                        <th class="text-center">Product</th>
                                        <th class="text-center">Domain</th>
                                        <th class="text-center">Price</th>
                                        <th class="text-center">Next Due Date</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (hostings && hostings.length > 0) { %>
                                        <% hostings.forEach(function(hosting, i) { %>
                                            <tr>
                                                <td class="text-center"><%= i + 1 %></td>
                                                <td><%= hosting.nama_hosting %></td>
                                                <td><%= hosting.domain %></td>
                                                <td class="text-right">
                                                    Rp <%= Number(hosting.harga).toLocaleString('id-ID') %>,-
                                                </td>
                                                <td class="text-center">
                                                    <% 
                                                      const dueDate = new Date(hosting.end_hosting);
                                                      const dd = String(dueDate.getDate()).padStart(2, '0');
                                                      const dm = String(dueDate.getMonth() + 1).padStart(2, '0');
                                                      const dy = dueDate.getFullYear();
                                                    %>
                                                    <%= `${dd}-${dm}-${dy}` %>
                                                </td>
                                                <td class="text-center">
                                                    <% if (hosting.status_hosting === 1) { %>
                                                        <small class="badge badge-success">ACTIVE</small>
                                                    <% } else if (hosting.status_hosting === 2) { %>
                                                        <small class="badge badge-warning">PENDING</small>
                                                    <% } else if (hosting.status_hosting === 3) { %>
                                                        <small class="badge badge-danger">SUSPENDED</small>
                                                    <% } else { %>
                                                        <small class="badge badge-secondary">TERMINATED</small>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <a href="/Service/detail/<%= encrypt(hosting.id) %>" class="btn btn-sm btn-info">
                                                        Detail
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-3">No hosting services found.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>

<%- include('../partials/user_footer') %>
